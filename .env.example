VITE_CONTACT_EMAIL=
VITE_BOOKING_RECIPIENT=
VITE_BOOKING_IFRAME_BASE=
VITE_VIVESTIA_BASE=

# Ads tracking (optional; leave empty to disable). Loaded only after cookie consent.
# Meta Pixel ID, e.g. 123456789012345
VITE_META_PIXEL_ID=
# Google Ads tag ID, e.g. AW-123456789
VITE_GOOGLE_ADS_ID=
# Google Ads conversion label for enquiry-form leads (the part after "/" in send_to)
VITE_GOOGLE_ADS_LEAD_LABEL=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (loaded only after consent too)
VITE_GA4_ID=

# Media site: the media/blog repo published on GitHub Pages, e.g.
# https://konkok.github.io/cms/  (GitHub Pages of the Konkok/cms repo)
# Required: photos, videos and the blog load from here, and the build
# (scripts/prerender.js) fetches the blog articles from it.
VITE_ASSET_BASE_URL=
