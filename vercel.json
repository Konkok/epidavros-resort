{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/hero-poster(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/guesty/(.*)",
      "destination": "https://app.guesty.com/api/pm-websites-backend/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
